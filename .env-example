MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cart_db
MONGO_COLLECTION=cart_items

# Internal K8s Service DNS for the Catalog microservice.
# In-cluster: http://catalog-service (or http://catalog-service.bazaar-dev.svc.cluster.local for full FQDN)
# Local development: use a locally running instance or a mock server.
CATALOG_SERVICE_URL=http://catalog-service

HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development